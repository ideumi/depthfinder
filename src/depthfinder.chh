#!/usr/bin/chippy
#
# depthfinder - depthfinder.chh
#

# Set timezone offset in libtime.chh
TIMEZONEOFFSET = CalculateTimezone();

var currentPath = "";
var files = [];

var selectedIndex = 1;
var scrollOffset = 1;

var showHidden = false;
var movingBookmark = false;
var showKeybinds = false;

var sortMode = SORTNAME;
var sortDirection = SORTASC;

var clipboard = [];
var clipboardMode = CLIPBOARDNONE;

var focusPanel = FOCUSBROWSER;

var bookmarks = [];
var selectedBookmark = 1;

var fileAssoc = [];

var terminal = "";

var screenWidth = MINTERMWIDTH;
var screenHeight = MINTERMHEIGHT;

var dirHistory = [];
var navigatingBack = false;

var winsizeHandle = err;

var inDialog = false;

#@ <ConfirmExit()>
#@ The exit confirmation dialog.

func ConfirmExit() {
	var confirmed = ShowConfirm(screenWidth, screenHeight, "Do you really want to exit?");

	return not iserr(confirmed) and confirmed;
}

#@ <HandleSidebarInput(key)>
#@ Handles key input when sidebar has focus.

func HandleSidebarInput(key) {
	# ESC
	if key == BFKEYESC {
		if movingBookmark {
			movingBookmark = false;
			SaveBookmarks(bookmarks);
		} elseif len(clipboard) > 0 {
			clipboard = [];
			clipboardMode = CLIPBOARDNONE;
		} else {
			if ConfirmExit() {
				return false;
			}
		}
	} elseif
	# TAB
	key == BFKEYTAB {
		if movingBookmark {
			movingBookmark = false;
			SaveBookmarks(bookmarks);
		}

		focusPanel = FOCUSBROWSER;
	} elseif
	# Up Arrow
	key == BFKEYUP {
		if movingBookmark and selectedBookmark > 1 {
			# Swap bookmark with one above
			var temp = bookmarks[selectedBookmark];

			bookmarks[selectedBookmark] = bookmarks[selectedBookmark - 1];
			bookmarks[selectedBookmark - 1] = temp;

			selectedBookmark = selectedBookmark - 1;
		} elseif selectedBookmark > 1 {
			selectedBookmark = selectedBookmark - 1;
		}
	} elseif
	# Down arrow
	key == BFKEYDOWN {
		if movingBookmark and selectedBookmark < len(bookmarks) {
			# Swap bookmark with one below
			var temp = bookmarks[selectedBookmark];

			bookmarks[selectedBookmark] = bookmarks[selectedBookmark + 1];
			bookmarks[selectedBookmark + 1] = temp;

			selectedBookmark = selectedBookmark + 1;
		} elseif selectedBookmark < len(bookmarks) {
			selectedBookmark = selectedBookmark + 1;
		}
	} elseif
	# Space
	key == KEYSPACE {
		if selectedBookmark >= 1 and selectedBookmark <= len(bookmarks) {
			if movingBookmark {
				movingBookmark = false;

				SaveBookmarks(bookmarks);
			} else {
				movingBookmark = true;
			}
		}
	} elseif
	# Enter, Right Arrow
	key == BFKEYENTER or key == BFKEYRIGHT {
		if selectedBookmark >= 1 and selectedBookmark <= len(bookmarks) {
			var bm = bookmarks[selectedBookmark];
			var path = bm["path"];

			if IsDir(path) {
				NavigateTo(path);
				focusPanel = FOCUSBROWSER;
			} else {
				ShowError(screenWidth, screenHeight, "Directory not found: " + path);
			}
		}
	} elseif
	# Home
	key == BFKEYHOME or key == BFKEYPAGEUP {
		if len(bookmarks) > 0 {
			selectedBookmark = 1;
		}
	} elseif
	# End
	key == BFKEYEND or key == BFKEYPAGEDOWN {
		if len(bookmarks) > 0 {
			selectedBookmark = len(bookmarks);
		}
	} elseif
	# Del
	key == BFKEYDELETE {
		if selectedBookmark >= 1 and selectedBookmark <= len(bookmarks) {
			var bm = bookmarks[selectedBookmark];
			var bmName = bm["name"];

			var confirmed = ShowConfirm(screenWidth, screenHeight, "Remove bookmark '" + bmName + "'?");

			if not iserr(confirmed) and confirmed {
				var result = RemoveBookmark(bookmarks, selectedBookmark);

				if not iserr(result) {
					bookmarks = result;

					if selectedBookmark > len(bookmarks) and len(bookmarks) > 0 {
						selectedBookmark = len(bookmarks);
					}

					if selectedBookmark < 1 and len(bookmarks) > 0 {
						selectedBookmark = 1;
					}
				} else {
					ShowError(screenWidth, screenHeight, "Failed to remove bookmark");
				}
			}
		}
	} elseif
	# 1-9 keys
	type(key) == "bytes" and len(key) == 1 and key[1] >= 49 and key[1] <= 57 {
		var bmIndex = key[1] - 48;

		if NavigateToBookmark(bmIndex) {
			focusPanel = FOCUSBROWSER;
		}
	}

	return true;
}

#@ <HandleBrowserInput(key)>
#@ Handles key input when browser has focus.

func HandleBrowserInput(key) {
	# ESC
	if key == BFKEYESC {
		if CountMarkedFiles(files) > 0 {
			files = ClearAllMarks(files);
		} elseif len(clipboard) > 0 {
			clipboard = [];
			clipboardMode = CLIPBOARDNONE;
		} else {
			if ConfirmExit() {
				return false;
			}
		}
	} elseif
	# TAB
	key == BFKEYTAB {
		focusPanel = FOCUSSIDEBAR;
	} elseif key == BFKEYUP {
		if selectedIndex > 1 {
			selectedIndex = selectedIndex - 1;

			AdjustScrollOffset();
		}
	} elseif
	# Down Arrow
	key == BFKEYDOWN {
		if selectedIndex < len(files) {
			selectedIndex = selectedIndex + 1;

			AdjustScrollOffset();
		}
	} elseif
	# PgUp
	key == BFKEYPAGEUP {
		var pageSize = GetVisibleFileCount();

		selectedIndex = selectedIndex - pageSize;

		if selectedIndex < 1 {
			selectedIndex = 1;
		}

		AdjustScrollOffset();
	} elseif
	# PgDown
	key == BFKEYPAGEDOWN {
		var pageSize = GetVisibleFileCount();

		selectedIndex = selectedIndex + pageSize;

		if selectedIndex > len(files) {
			selectedIndex = len(files);
		}

		AdjustScrollOffset();
	} elseif
	# Home
	key == BFKEYHOME {
		selectedIndex = 1;
		scrollOffset = 1;
	} elseif
	# End
	key == BFKEYEND {
		selectedIndex = len(files);

		AdjustScrollOffset();
	} elseif
	# Enter, Right Arrow
	key == BFKEYENTER or key == BFKEYRIGHT {
		NavigateInto();
	} elseif
	# Alt + Left Arrow
	key == KEYALTLEFT {
		NavigateBack();
	} elseif
	# Left Arrow
	key == BFKEYLEFT {
		NavigateUp();
	} elseif
	# Space
	key == KEYSPACE {
		if selectedIndex >= 1 and selectedIndex <= len(files) {
			var name = files[selectedIndex]["name"];

			if name != ".." {
				files = ToggleFileMark(files, selectedIndex);
			}
		}
	} elseif
	# a or A
	key == KEYA or key == KEYAA {
		files = ToggleSelectAll(files);
	} elseif
	# s or S
	key == KEYS or key == KEYSS {
		var browserWidth = screenWidth - SIDEBARWIDTH - 2;
		var browserHeight = screenHeight - BottomReserve() - 2;

		var searchWidth = int(browserWidth * 80 / 100);
		var searchHeight = int(browserHeight * 80 / 100);

		var searchX = SIDEBARWIDTH + 2 + int((browserWidth - searchWidth) / 2);
		var searchY = 1 + int((browserHeight - searchHeight) / 2);

		var result = SearchMode(searchX, searchY, searchWidth, searchHeight, files);

		if not iserr(result) {
			selectedIndex = result;

			AdjustScrollOffset();
		}
	} elseif
	# r or R
	key == KEYR or key == KEYRR {
		ClearScreen();
		RefreshDirectory();
	} elseif
	# h or H
	key == KEYH or key == KEYHH {
		showHidden = not showHidden;

		RefreshDirectory();
	} elseif
	# Ctrl + C
	key == KEYCTRLC {
		var selected = GetSelectedFiles(files, currentPath, selectedIndex);

		if len(selected) > 0 {
			clipboard = selected;
			clipboardMode = CLIPBOARDCOPY;

			files = ClearAllMarks(files);
		}
	} elseif
	# Ctrl + X
	key == KEYCTRLX {
		var selected = GetSelectedFiles(files, currentPath, selectedIndex);

		if len(selected) > 0 {
			clipboard = selected;
			clipboardMode = CLIPBOARDCUT;

			files = ClearAllMarks(files);
		}
	} elseif
	# Ctrl + V
	key == KEYCTRLV {
		ActionPaste();
	} elseif
	# Del
	key == BFKEYDELETE {
		var selected = GetSelectedFiles(files, currentPath, selectedIndex);

		if len(selected) > 0 {
			var result = DeleteFiles(selected, screenWidth, screenHeight);

			if isok(result) {
				files = ClearAllMarks(files);
			}

			RefreshDirectory();
		}
	} elseif
	# Ctrl + N
	key == KEYCTRLN {
		OpenNewWindow();
	} elseif
	# F1
	key == KEYF1 {
		OpenTerminal();
	} elseif
	# F2
	key == KEYF2 {
		ActionRename();
	} elseif
	# o or O
	key == KEYO or key == KEYOO {
		ActionOpenWith();
	} elseif
	# n or N
	key == KEYN or key == KEYNN {
		ActionNewFile();
	} elseif
	# d or D
	key == KEYD or key == KEYDD {
		ActionNewDir();
	} elseif
	# i or I
	key == KEYI or key == KEYII {
		if selectedIndex >= 1 and selectedIndex <= len(files) {
			var entry = files[selectedIndex];
			var name = entry["name"];

			if name != ".." {
				var fullPath = JoinPath(currentPath, name);

				ShowFileInfo(screenWidth, screenHeight, fullPath);
			}
		}
	} elseif
	# Hash
	key == KEYHASH {
		ActionRunCommand();
	} elseif
	# p or P
	key == KEYP or key == KEYPP {
		var newPath = ShowInput(screenWidth, screenHeight, "Go To", "Path: ", currentPath);

		if not iserr(newPath) and newPath != "" {
			if IsDir(newPath) {
				NavigateTo(newPath);
			} else {
				ShowError(screenWidth, screenHeight, "Not a directory: " + newPath);
			}
		}
	} elseif
	# b or B
	key == KEYB or key == KEYBB {
		ActionAddBookmark();
	} elseif
	# t or T
	key == KEYT or key == KEYTT {
		ActionSort();
	} elseif
	# c or C
	key == KEYC or key == KEYCC {
		ActionCompress();
	} elseif
	# 1-9 keys
	type(key) == "bytes" and len(key) == 1 and key[1] >= 49 and key[1] <= 57 {
		var bmIndex = key[1] - 48;

		NavigateToBookmark(bmIndex);
	}

	return true;
}

#@ <CurrentState()>
#@ Packs the render-relevant globals into a single map so the winsize actor can
#@ repaint with up-to-date state.

func CurrentState() {
	return m[
		"bookmarks": bookmarks,
		"selectedBookmark": selectedBookmark,
		"files": files,
		"selectedIndex": selectedIndex,
		"scrollOffset": scrollOffset,
		"currentPath": currentPath,
		"focusPanel": focusPanel,
		"clipboardMode": clipboardMode,
		"showHidden": showHidden,
		"movingBookmark": movingBookmark,
		"sortMode": sortMode,
		"sortDirection": sortDirection,
		"inDialog": inDialog
	];
}

#@ <EnterDialog()>
#@ Sets the in-dialog flag and tells the winsize actor to suppress repaints
#@ until the dialog returns.

func EnterDialog() {
	inDialog = true;

	if not iserr(winsizeHandle) {
		send(winsizeHandle, CurrentState());
	}
}

#@ <ExitDialog()>
#@ Clears the in-dialog flag.

func ExitDialog() {
	inDialog = false;

	if not iserr(winsizeHandle) {
		send(winsizeHandle, CurrentState());
	}
}

#@ <WinChangeActor()>
#@ Actor for detecting and acting :D on window size changes

func WinChActor() {
	sigcatch([SIGWINCH]);

	var state = m[];

	while true {
		signal();

		var msgs = receive(false);

		if len(msgs) > 0 {
			state = msgs[len(msgs)];
		}

		if len(state) == 0 {
			continue;
		}

		if state["inDialog"] {
			continue;
		}

		var size = winsize();

		if iserr(size) {
			continue;
		}

		screenHeight = size["rows"];
		screenWidth = size["columns"];

		if screenWidth < MINTERMWIDTH or screenHeight < MINTERMHEIGHT {
			continue;
		}

		# Re-clamp against the new viewport before drawing.
		files = state["files"];
		selectedIndex = state["selectedIndex"];
		scrollOffset = state["scrollOffset"];

		AdjustScrollOffset();

		ClearScreen();

		DrawScreen(screenWidth,
			screenHeight,
			state["bookmarks"],
			state["selectedBookmark"],
			files,
			selectedIndex,
			scrollOffset,
			state["currentPath"],
			state["focusPanel"],
			CountMarkedFiles(files),
			state["clipboardMode"],
			state["showHidden"],
			state["movingBookmark"],
			state["sortMode"],
			state["sortDirection"]);
	}
}

#@ <MainLoop()>
#@ Main event loop.

func MainLoop() {
	var running = true;

	while running {
		inDialog = false;

		var termSize = winsize();

		if not iserr(termSize) {
			screenHeight = termSize["rows"];
			screenWidth = termSize["columns"];
		}

		# Do not render when it is expected that rendering causes broken elements
		# on the screen.
		if screenWidth < MINTERMWIDTH or screenHeight < MINTERMHEIGHT {
			ClearScreen();
			CursorTo(1, 1);

			Print("Terminal too small");
			getch();

			continue;
		}

		# Viewport size may have changed while getch() was blocked. Re-clamp so
		# the selection stays visible.
		AdjustScrollOffset();

		var markedCount = CountMarkedFiles(files);

		DrawScreen(screenWidth,
			screenHeight,
			bookmarks,
			selectedBookmark,
			files,
			selectedIndex,
			scrollOffset,
			currentPath,
			focusPanel,
			markedCount,
			clipboardMode,
			showHidden,
			movingBookmark,
			sortMode,
			sortDirection);

		send(winsizeHandle, CurrentState());

		var key = getch();

		var postSize = winsize();

		if not iserr(postSize) {
			screenHeight = postSize["rows"];
			screenWidth = postSize["columns"];
		}

		# Re-clamp before input handlers run so they compute against the
		# same scrollOffset the actor used to redraw.
		AdjustScrollOffset();

		# Handling KEYDOT must be here since the keybinds bar toggle should work
		# in both sidebar and non sidebar focus modes
		if key == KEYDOT {
			showKeybinds = not showKeybinds;

			ClearScreen();

			continue;
		}

		if focusPanel == FOCUSSIDEBAR {
			running = HandleSidebarInput(key);
		} else {
			running = HandleBrowserInput(key);
		}
	}
}

#@ <Init()>
#@ Initializes the application by creating (if needed) and loading all config
#@ files and determining starting directory. It also spawns the window-resize
#@ detection actor.

func Init() {
	CreateDefaultBookmarks();
	CreateDefaultFileAssoc();
	CreateDefaultTerminal();
	CreateDefaultLastDir();

	# Load configs

	var loadedBookmarks = LoadBookmarks();

	if iserr(loadedBookmarks) {
		bookmarks = [];
	} else {
		bookmarks = loadedBookmarks;
	}

	var loadedAssoc = LoadFileAssoc();

	if iserr(loadedAssoc) {
		fileAssoc = m[];
	} else {
		fileAssoc = loadedAssoc;
	}

	var loadedTerminal = LoadTerminal();
	if not iserr(loadedTerminal) {
		terminal = loadedTerminal;
	}

	# Determine starting directory
	var startPath = LoadLastDir();

	if iserr(startPath) {
		startPath = getenv("HOME");

		if iserr(startPath) {
			startPath = "/";
		}
	}

	# If we have a CLI arg and it is a directory, move to it
	var cmdArgs = args();

	if not iserr(cmdArgs) and len(cmdArgs) >= 1 {
		var argPath = cmdArgs[1];

		if IsDir(argPath) {
			startPath = AbsolutePath(argPath);
		}
	}

	NavigateTo(startPath);

	# Spawn the window resize detector
	winsizeHandle = actor(WinChActor);
}

#@ <Cleanup()>
#@ Cleanup before exit.

func Cleanup() {
	ShowCursor();
	ClearScreen();
}

#@ <Main()>
#@ Entry point.

func Main() {
	SetTitle(PROGRAMNAME + " V-" + VERSION);

	ClearScreen();
	HideCursor();

	Init();
	MainLoop();

	# The WinChActor has no explicit exit path, signal() is blocking so there is
	# no way to just send it an exit command, makes no difference. Practical dead-
	# lock.
	# wait(winsizeHandle);

	Cleanup();
}

Main();
