#!/usr/bin/chippy
#
# depthfinder - actions.chh
#

#@ <ApplyExtension(name, originalName)>
#@ Replaces ''*'' in ''name'' with the file extension from ''originalName''.

func ApplyExtension(name, originalName)
{
	var ext = FileExtension(originalName);

	if ext == ""
	{
		name = replace(name, ".*", "");
		name = replace(name, "*", "");
	}
	else
	{
		name = replace(name, "*", ext);
	}

	return name;
}

#@ <ApplyRenamePattern(pattern, number, padWidth, originalName)>
#@ Replaces ''#'' with zero-padded ''number'' and ''*'' with the original file
#@ extension.

func ApplyRenamePattern(pattern, number, padWidth, originalName)
{
	var result = replace(pattern, "#", ZeroPad(number, padWidth));

	return ApplyExtension(result, originalName);
}

#@ <ActionRename()>
#@ Handles the rename action for the selected file.

func ActionRename()
{
	var markedCount = CountMarkedFiles(files);

	if markedCount > 1
	{
		ActionBulkRename();
		return;
	}

	var renameIndex = selectedIndex;

	if markedCount == 1
	{
		for fileIndex = 1 to len(files)
		{
			if files[fileIndex]["marked"] { renameIndex = fileIndex; }
		}
	}

	if renameIndex < 1 or renameIndex > len(files) { return; }

	var entry = files[renameIndex];
	var oldName = entry["name"];

	if oldName == ".." { return; }

	var newName = ShowInput(screenWidth, screenHeight, "Rename", "New name: ", oldName);

	if iserr(newName) or newName == "" { return; }

	newName = ApplyExtension(newName, oldName);

	# ---

	if newName == "" or newName == oldName { return; }

	var oldPath = JoinPath(currentPath, oldName);
	var newPath = JoinPath(currentPath, newName);

	if IsSameFile(oldPath, newPath)
	{
		ShowError(screenWidth, screenHeight,
			"Cannot rename: source and destination are the same file");

		return;
	}

	var doRename = true;

	if PathExists(newPath)
	{
		var confirmOverwrite = ShowConfirm(screenWidth,
			screenHeight, "'" + newName + "' exists. Overwrite?");

		if iserr(confirmOverwrite) or not confirmOverwrite { doRename = false; }
	}

	if doRename
	{
		var result = rename(oldPath, newPath);

		if iserr(result)
		{
			ShowError(screenWidth, screenHeight, "Failed to rename: " + oldName);
		}
	}

	RefreshDirectory();
}

#@ <ActionBulkRename()>
#@ Handles the bulk-rename action for the selected files.

func ActionBulkRename()
{
	var selected = GetSelectedFiles(files, currentPath, selectedIndex);
	var total = len(selected);

	if total == 0 { return; }

	var pattern = ShowRenameInput(screenWidth, screenHeight,
		"Bulk Rename (" + str(total) + " files)",
		"Pattern: ", Basename(selected[1]));

	if iserr(pattern) or pattern == "" { return; }

	if not has(pattern, "#")
	{
		ShowError(screenWidth, screenHeight,
			"Pattern must contain # as a number placeholder");

		return;
	}

	var padWidth = len(str(total));

	# Conflict pre-checks
	for renameIndex = 1 to total
	{
		var newName = ApplyRenamePattern(pattern, renameIndex, padWidth, Basename(selected[renameIndex]));
		var newPath = JoinPath(currentPath, newName);

		if PathExists(newPath)
		{
			# Allow if target is a selected file that will be renamed at or
			# before this index
			var isHandled = false;

			for earlierIndex = 1 to renameIndex
			{
				if IsSameFile(selected[earlierIndex], newPath)
				{
					isHandled = true;
					break;
				}
			}

			if not isHandled
			{
				ShowError(screenWidth, screenHeight, "'" + newName + "' already exists");
				return;
			}
		}
	}

	var first = ApplyRenamePattern(pattern, 1, padWidth, Basename(selected[1]));
	var last = ApplyRenamePattern(pattern, total, padWidth, Basename(selected[total]));

	var preview = "Rename " + str(total) + " files? (" + first + " ... " + last + ")";
	var confirmed = ShowConfirm(screenWidth, screenHeight, preview);

	if iserr(confirmed) or not confirmed { return; }

	for renameIndex = 1 to total
	{
		var oldPath = selected[renameIndex];
		var newName = ApplyRenamePattern(pattern, renameIndex, padWidth, Basename(oldPath));
		var newPath = JoinPath(currentPath, newName);

		var result = rename(oldPath, newPath);

		if iserr(result)
		{
			var displayName = BFTruncateMiddle(Basename(oldPath), DIALOGNAMEMAX);

			ShowError(screenWidth, screenHeight, "Failed to rename: " + displayName);

			RefreshDirectory();
			return;
		}
	}

	files = ClearAllMarks(files);

	RefreshDirectory();
}

#@ <ActionOpenWith()>
#@ Handles opening selected files with a custom command. Commands prefixed with
#@ ''!'' run in terminal foreground.

func ActionOpenWith()
{
	var filesToOpen = GetSelectedFiles(files, currentPath, selectedIndex);

	if len(filesToOpen) == 0 { return; }

	var cmd = ShowInput(screenWidth, screenHeight, "Open With", "Command: ", "");

	if iserr(cmd) or cmd == "" { return; }

	# TUI prefix for foreground TUI programs
	var parsed = StripTuiPrefix(cmd);
	var fullCmd = parsed[1];

	# NOTE: Otherwise programs like VLC etc. open files in the wrong order
	sort(filesToOpen);

	for fileIndex = 1 to len(filesToOpen)
	{
		fullCmd = fullCmd + " " + ShellEscape(filesToOpen[fileIndex]);
	}

	RunCommand(fullCmd, parsed[2]);

	files = ClearAllMarks(files);
}

#@ <ActionNewFile()>
#@ Handles creating a new file.

func ActionNewFile()
{
	var name = ShowInput(screenWidth, screenHeight, "New File", "Name: ", "");

	if iserr(name) or name == "" { return; }

	var fullPath = JoinPath(currentPath, name);

	if PathExists(fullPath)
	{
		ShowError(screenWidth, screenHeight, "'" + name + "' already exists");
	}
	else
	{
		var result = WriteFile(fullPath, "", true, false);

		if iserr(result)
		{
			ShowError(screenWidth, screenHeight, "Failed to create file: " + name);
		}
	}

	RefreshDirectory();
}

#@ <ActionNewDir()>
#@ Handles creating a new directory.

func ActionNewDir()
{
	var name = ShowInput(screenWidth, screenHeight, "New Directory", "Name: ", "");

	if iserr(name) or name == "" { return; }

	var fullPath = JoinPath(currentPath, name);

	if PathExists(fullPath)
	{
		ShowError(screenWidth, screenHeight, "'" + name + "' already exists");
	}
	else
	{
		var result = CreateDir(fullPath);

		if iserr(result)
		{
			ShowError(screenWidth, screenHeight, "Failed to create directory: " + name);
		}
	}

	RefreshDirectory();
}

#@ <ActionRunCommand()>
#@ Handles running a shell command in the current directory.

func ActionRunCommand()
{
	var prompt = "$ ";
	if RUNNINGASROOT { prompt = "# "; }

	var cmd = ShowInput(screenWidth, screenHeight, "Run Command", prompt, "");

	if iserr(cmd) or cmd == "" { return; }

	# Egg
	if cmd == EGG
	{
		ShowAbout(screenWidth, screenHeight);
		return;
	}

	RunForeground(cmd);
}

#@ <ActionAddBookmark()>
#@ Handles adding the current directory as a bookmark.

func ActionAddBookmark()
{
	var defaultName = Basename(currentPath);

	if defaultName == "" { defaultName = "/"; }

	var bmName = ShowInput(screenWidth, screenHeight, "Add Bookmark", "Name: ", defaultName);

	if iserr(bmName) or bmName == "" { return; }

	var result = AddBookmark(bookmarks, bmName, currentPath);

	if not iserr(result) { bookmarks = result; }
	else { ShowError(screenWidth, screenHeight, "Failed to save bookmark"); }
}

#@ <ActionSort()>
#@ Handles showing the sort menu and applying sort settings.

func ActionSort()
{
	var result = ShowSortMenu(screenWidth, screenHeight, sortMode, sortDirection);

	if not iserr(result)
	{
		sortMode = result[1];
		sortDirection = result[2];

		RefreshDirectory();
	}
}

#@ <ActionPaste()>
#@ Handles pasting files from clipboard.

func ActionPaste()
{
	if len(clipboard) == 0 { return; }

	var result = err;

	if clipboardMode == CLIPBOARDCOPY
	{
		result = CopyFiles(clipboard, currentPath, screenWidth, screenHeight);
	}
	elseif clipboardMode == CLIPBOARDCUT
	{
		result = MoveFiles(clipboard, currentPath, screenWidth, screenHeight);

		if isok(result) { ClearClipboard(); }
	}

	RefreshDirectory();
}

#@ <ActionDelete()>
#@ Handles deleting the selected files.

func ActionDelete()
{
	var selected = GetSelectedFiles(files, currentPath, selectedIndex);

	if len(selected) > 0
	{
		var result = DeleteFiles(selected, screenWidth, screenHeight);

		if isok(result) { files = ClearAllMarks(files); }

		RefreshDirectory();
	}
}

#@ <ActionFileInfo()>
#@ Handles showing the info dialog for the selected files.

func ActionFileInfo()
{
	var selected = GetSelectedFiles(files, currentPath, selectedIndex);

	if len(selected) > 0 { ShowFileInfo(screenWidth, screenHeight, selected); }
}

#@ <ActionGoToPath()>
#@ Handles prompting for a directory path and navigating to it.

func ActionGoToPath()
{
	var newPath = ShowInput(screenWidth, screenHeight, "Go To", "Path: ", currentPath);

	if not iserr(newPath) and newPath != ""
	{
		if IsDir(newPath)
		{
			NavigateTo(newPath);
		}
		else
		{
			ShowError(screenWidth, screenHeight, "Not a directory: " + newPath);
		}
	}
}

#@ <ActionSearch()>
#@ Handles the search dialog and moves the selection to the chosen file.

func ActionSearch()
{
	var region = GetBrowserRegion(screenWidth, screenHeight);

	var browserWidth = region[3];
	var browserHeight = region[4] - 2;

	var searchWidth = int(browserWidth * 80 / 100);
	var searchHeight = int(browserHeight * 80 / 100);

	var searchX = region[1] + int((browserWidth - searchWidth) / 2);
	var searchY = region[2] + int((browserHeight - searchHeight) / 2);

	var result = SearchMode(searchX, searchY, searchWidth, searchHeight, files);

	if not iserr(result)
	{
		selectedIndex = result;

		AdjustScrollOffset();
	}
}

#@ <ActionCompress()>
#@ Handles compressing selected files into an archive.

func ActionCompress()
{
	var filesToCompress = GetSelectedFiles(files, currentPath, selectedIndex);

	if len(filesToCompress) == 0 { return; }

	var format = ShowCompressMenu(screenWidth, screenHeight);

	if iserr(format) { return; }

	var defaultName = "archive";

	if len(filesToCompress) == 1 { defaultName = Basename(filesToCompress[1]); }

	var archiveName = ShowInput(screenWidth, screenHeight, "Archive Name",
		"Name: ", defaultName);

	if iserr(archiveName) or archiveName == "" { return; }

	var result = CompressFiles(filesToCompress,
		currentPath,
		archiveName,
		format,
		screenWidth,
		screenHeight);

	if isok(result) { files = ClearAllMarks(files); }

	RefreshDirectory();
}
