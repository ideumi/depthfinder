#!/usr/bin/chippy
#
# depthfinder - search.chh
#

#@ <FilterFiles(files, query)>
#@ Filters ''files'' by name substring. Returns filtered list with original indices
#@ preserved in ''origIndex''.
#@
#@ Map fields: the file entry map fields from ''CreateFileEntry()'', and:
#@ - ''"origIndex"'' (Number): index of the entry in the original unfiltered list

func FilterFiles(files, query)
{
	if query == "" { return []; }

	var results = [];
	var lowerQuery = lower(query);

	for fileIndex = 1 to len(files)
	{
		var entry = files[fileIndex];
		var name = lower(entry["name"]);

		if has(name, lowerQuery)
		{
			var result = copy(entry);
			result["origIndex"] = fileIndex;

			append(results, result);
		}
	}

	return results;
}

#@ <SearchMode(x, y, width, height, files)>
#@ Interactive search mode dialog. Returns the original index of the selected
#@ file, or ''err'' on cancel.

func SearchMode(x, y, width, height, files)
{
	var query = "";
	var results = [];
	var selected = 1;
	var offset = 1;
	var running = true;
	var result = err;

	HideCursor();

	while running
	{
		results = FilterFiles(files, query);

		if selected > len(results) and len(results) > 0
		{
			selected = len(results);
		}

		if selected < 1 and len(results) > 0 { selected = 1; }

		if selected < offset { offset = selected; }

		var listHeight = height - 4;

		if selected >= offset + listHeight
		{
			offset = selected - listHeight + 1;
		}

		# ---

		# Draw "Window"
		BFDrawFrame(x, y, width, height, "Search", BFBOXROUNDED);

		var promptY = y + 1;
		var promptText = "Find: " + query + "_";

		promptText = BFClipText(promptText, width - 2);
		promptText = BFPadText(promptText, width - 2, BFALIGNLEFT);

		BFDrawText(x + 1, promptY, promptText);

		# Draw search textbox separator
		BFDrawHLine(x + 1, promptY + 1, width - 2, "─");

		# Draw results
		var listY = promptY + 2;
		var listWidth = width - 2;

		for row = 1 to listHeight
		{
			var idx = offset + row - 1;

			if idx <= len(results)
			{
				var entry = results[idx];
				var name = entry["name"];
				var isDir = entry["isDir"];
				var isSymlink = entry["isSymlink"];
				var isExecutable = entry["isExecutable"];

				if isDir { name = str(name) + "/"; }

				var displayText = BFClipText(str(name), listWidth);
				displayText = BFPadText(displayText, listWidth, BFALIGNLEFT);

				if idx == selected
				{
					SetAttribute(COLORBLACK);
					SetAttribute(COLORBOLD);
					SetAttribute(COLORBGWHITE);
				}
				else
				{
					SetFileTypeColor(isSymlink, isDir, isExecutable);
				}

				BFDrawText(x + 1, listY + row - 1, displayText);
				SetAttribute(COLORRESET);
			}
			else
			{
				BFClearRegion(x + 1, listY + row - 1, listWidth, 1);
			}
		}

		# Draw status
		var statusY = y + height - 1;
		var statusText = str(len(results)) + " matches | ESC:Cancel | Enter:Select";

		statusText = BFClipText(statusText, width - 2);

		BFDrawText(x + 1, statusY, statusText);

		# ---

		var key = getch();

		if key == BFKEYESC
		{
			result = err;
			running = false;
		}
		elseif key == BFKEYENTER or key == BFKEYRIGHT
		{
			if len(results) > 0 and selected >= 1 and selected <= len(results)
			{
				result = results[selected]["origIndex"];
			}

			running = false;
		}
		elseif key == BFKEYUP
		{
			if selected > 1 { selected = selected - 1; }
		}
		elseif key == BFKEYDOWN
		{
			if selected < len(results) { selected = selected + 1; }
		}
		elseif key == BFKEYBACKSPACE
		{
			if len(query) > 0
			{
				query = slice(query, 1, len(query) - 1);

				selected = 1;
				offset = 1;
			}
		}
		elseif key == BFKEYDELETE or key == BFKEYCTRLU
		{
			query = "";

			selected = 1;
			offset = 1;
		}
		elseif IsTextKey(key)
		{
			query = query + unpack(key);

			selected = 1;
			offset = 1;
		}
	}

	return result;
}
