#!/usr/bin/chippy
#
# depthfinder - util.chh
#

#@ <ZeroPad(number, width)>
#@ Returns ''number'' as a string left-padded with zeros to at least ''width''
#@ characters. Fractional parts are truncated.

func ZeroPad(number, width)
{
	var padded = str(int(number));

	while len(padded) < width { padded = "0" + padded; }

	return padded;
}

#@ <OwnerPermBits(mode)>
#@ Returns the owner number of the permission ''mode''.

func OwnerPermBits(mode)
{
	return int(mode / 100) % 10;
}

#@ <IsExecutableMode(mode, isDir)>
#@ Returns if ''mode'' grants the owner execute permission on a non dir.

func IsExecutableMode(mode, isDir)
{
	return not isDir and OwnerPermBits(mode) % 2 == 1;
}

#@ <FormatPermissions(mode)>
#@ Formats permission ''mode'' as human readable string.

func FormatPermissions(mode)
{
	var ownerPerm = OwnerPermBits(mode);
	var parts = [];

	if int(ownerPerm / 4) % 2 == 1 { append(parts, "read"); }
	if int(ownerPerm / 2) % 2 == 1 { append(parts, "write"); }
	if ownerPerm % 2 == 1 { append(parts, "execute"); }

	if len(parts) == 0 { return "no access"; }

	return join(parts, ", ");
}

#@ <GetUsernameByUID(uid)>
#@ Looks up username from ''/etc/passwd'' by ''uid''. Returns ''uid'' as string
#@ if not found.

func GetUsernameByUID(uid)
{
	var content = ReadFile("/etc/passwd", true);

	if iserr(content) { return str(uid); }

	var lines = split(content, "\n");

	for lineIndex = 1 to len(lines)
	{
		var line = lines[lineIndex];

		if line == "" { continue; }

		var parts = split(line, ":");

		if len(parts) >= 3 and parts[3] == str(uid) { return parts[1]; }
	}

	return str(uid);
}

#@ <IsSingleByteKey(key)>
#@ Returns if ''key'' is a single byte keypress (ASCII).

func IsSingleByteKey(key)
{
	return type(key) == "bytes" and len(key) == 1;
}

#@ <DigitKey(key)>
#@ Returns the digit 1-9 for a ''1''-''9'' keypress, or 0 for any other key.

func DigitKey(key)
{
	if not IsSingleByteKey(key) { return 0; }

	if key[1] < 49 or key[1] > 57 { return 0; }

	return key[1] - 48;
}

#@ <IsTextKey(key)>
#@ Returns if ''key'' is a text keypress (printable ASCII or UTF-8) and not a
#@ control byte or an escape sequence.

func IsTextKey(key)
{
	if type(key) != "bytes" or len(key) == 0 { return false; }

	return key[1] >= 32;
}

#@ <ShellEscape(text)>
#@ Escapes a string for safe use in shell commands.

func ShellEscape(text)
{
	var escaped = replace(text, "'", "'\\''");

	return "'" + escaped + "'";
}
