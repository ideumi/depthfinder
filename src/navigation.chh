#!/usr/bin/chippy
#
# depthfinder - navigation.chh
#

#@ <GetParentPath(path)>
#@ Returns the parent directory path.

func GetParentPath(path)
{
	if path == "/" { return "/"; }

	return Dirname(path);
}

#@ <UpdateTitle()>
#@ Updates the terminal title to reflect the current directory.

func UpdateTitle()
{
	var dirName = Basename(currentPath);

	if dirName == "" { dirName = "/"; }

	SetTitle(dirName + " - " + PROGRAMNAME);
}

#@ <RefreshDirectory()>
#@ Reloads the current directory contents.

func RefreshDirectory()
{
	var loadResult = LoadDirectory(currentPath, showHidden, sortMode, sortDirection);

	if iserr(loadResult)
	{
		files = [];

		ShowError(screenWidth, screenHeight, "Cannot read directory: " + currentPath);
	}
	else
	{
		files = loadResult;
	}

	# Out of bounds reset
	if selectedIndex > len(files) and len(files) > 0
	{
		selectedIndex = len(files);
	}

	if selectedIndex < 1 and len(files) > 0 { selectedIndex = 1; }

	AdjustScrollOffset();
}

#@ <SyncBookmarkSelection()>
#@ Moves the sidebar cursor to the bookmark that points to ''currentPath'' if one
#@ exists.

func SyncBookmarkSelection()
{
	for bookmarkIndex = 1 to len(bookmarks)
	{
		if bookmarks[bookmarkIndex]["path"] == currentPath
		{
			selectedBookmark = bookmarkIndex;

			break;
		}
	}
}

#@ <NavigateTo(path)>
#@ Changes to the specified directory.

func NavigateTo(path)
{
	if path == "" { path = "/"; }

	if not IsDir(path) { return; }

	# Push current path to history before navigating away
	if not navigatingBack and currentPath != ""
	{
		append(dirHistory, currentPath);

		# Drop the oldest entry at index 1 when we reach the limit
		if len(dirHistory) > DIRHISTORYMAX { dirHistory = dirHistory - 1; }
	}

	chdir(path);
	currentPath = path;
	SaveLastDir(path);

	RefreshDirectory();

	# Row 1 is the ".." parent entry (absent at "/"), so land on the first real
	# entry at row 2, or on row 1 when the listing holds nothing but the parent
	# entry
	if path != "/" and len(files) > 1 { selectedIndex = 2; }
	else { selectedIndex = 1; }

	# Scroll back to the top of the new listing
	scrollOffset = 1;

	UpdateTitle();
}

#@ <NavigateUp()>
#@ Navigates to the parent directory.

func NavigateUp()
{
	var parent = GetParentPath(currentPath);

	if parent != currentPath
	{
		var oldName = Basename(currentPath);

		NavigateTo(parent);

		# Try to select the directory we came from
		for fileIndex = 1 to len(files)
		{
			if files[fileIndex]["name"] == oldName
			{
				selectedIndex = fileIndex;

				AdjustScrollOffset();

				break;
			}
		}
	}
}

#@ <NavigateInto()>
#@ Enters the selected directory or opens the selected file(s).

func NavigateInto()
{
	if len(files) == 0 { return; }

	if selectedIndex < 1 or selectedIndex > len(files) { return; }

	var selectedFiles = GetMarkedFiles(files, currentPath);

	if len(selectedFiles) > 1
	{
		for fileIndex = 1 to len(selectedFiles)
		{
			OpenFile(selectedFiles[fileIndex]);
		}

		files = ClearAllMarks(files);

		return;
	}

	var entry = files[selectedIndex];
	var name = entry["name"];
	var isDir = entry["isDir"];

	if name == ".."
	{
		NavigateUp();

		return;
	}

	var fullPath = JoinPath(currentPath, name);

	if isDir
	{
		NavigateTo(fullPath);
	}
	else
	{
		OpenFile(fullPath);

		if entry["marked"] { files = ToggleFileMark(files, selectedIndex); }
	}
}

#@ <GetVisibleFileCount()>
#@ Returns how many files can be displayed at once.

func GetVisibleFileCount()
{
	var region = GetBrowserListRegion(screenWidth, screenHeight);

	# Each entry occupies FILEROWHEIGHT rows on screen
	return int(region[4] / FILEROWHEIGHT);
}

#@ <GetVisibleBookmarkCount()>
#@ Returns how many bookmarks can be displayed at once.

func GetVisibleBookmarkCount()
{
	var region = GetSidebarRegion(screenHeight);

	# One row is reserved at the top of the panel, above the bookmark list
	return region[4] - SIDEBARHEADERROWS;
}

#@ <AdjustBookmarkScroll()>
#@ Keeps the selected bookmark visible in the sidebar.

func AdjustBookmarkScroll()
{
	var visibleBookmarks = GetVisibleBookmarkCount();

	# ''bookmarkScrollOffset'' is the index of the first visible bookmark.

	# The sidebar shows rows from bookmarkScrollOffset to
	# bookmarkScrollOffset + visibleBookmarks - 1, one row per bookmark

	# Selection above the sidebar: start the sidebar at the selection
	if selectedBookmark < bookmarkScrollOffset
	{
		bookmarkScrollOffset = selectedBookmark;
	}

	# Selection below the sidebar: slide the sidebar down until the selection is
	# its last visible row
	if selectedBookmark >= bookmarkScrollOffset + visibleBookmarks
	{
		bookmarkScrollOffset = selectedBookmark - visibleBookmarks + 1;
	}

	# After this, the panel is in one of two states. If the list is longer than
	# the panel, every row holds a real entry, the selection is one of them, and
	# the furthest top row is the one where the last visible entry is the last
	# entry in the list. If the list is shorter, the entries sit on the top rows,
	# the rest is blank, and the top row stays at 1
	var maxOffset = len(bookmarks) - visibleBookmarks + 1;

	if maxOffset < 1 { maxOffset = 1; }
	if bookmarkScrollOffset > maxOffset { bookmarkScrollOffset = maxOffset; }
	if bookmarkScrollOffset < 1 { bookmarkScrollOffset = 1; }
}

#@ <AdjustScrollOffset()>
#@ Keeps the selection visible in the file list.

func AdjustScrollOffset()
{
	var visibleFiles = GetVisibleFileCount();

	# ''scrollOffset'' is the index of the first visible row.

	# The file list shows rows from scrollOffset to scrollOffset + visibleFiles - 1,
	# each entry takes FILEROWHEIGHT rows on screen

	# Selection above the file list: start the file list at the selection
	if selectedIndex < scrollOffset { scrollOffset = selectedIndex; }

	# Selection below the file list: slide the file list down until the
	# selection is its last visible row
	if selectedIndex >= scrollOffset + visibleFiles
	{
		scrollOffset = selectedIndex - visibleFiles + 1;
	}

	# After this, the panel is in one of two states. If the list is longer than
	# the panel, every row holds a real entry, the selection is one of them, and
	# the furthest top row is the one where the last visible entry is the last
	# entry in the list. If the list is shorter, the entries sit on the top rows,
	# the rest is blank, and the top row stays at 1
	var maxOffset = len(files) - visibleFiles + 1;

	if maxOffset < 1 { maxOffset = 1; }
	if scrollOffset > maxOffset { scrollOffset = maxOffset; }
	if scrollOffset < 1 { scrollOffset = 1; }
}

#@ <MoveSelection(delta)>
#@ Moves the browser selection by ''delta'' rows.

func MoveSelection(delta)
{
	if len(files) == 0 { return; }

	selectedIndex = selectedIndex + delta;

	if selectedIndex < 1 { selectedIndex = 1; }
	if selectedIndex > len(files) { selectedIndex = len(files); }

	AdjustScrollOffset();
}

#@ <MoveSelectionRedraw(delta)>
#@ Moves the selection by ''delta'' and repaints only the two changed rows when the
#@ list did not scroll, in which case the main loop is told to skip its full redraw.

func MoveSelectionRedraw(delta)
{
	var oldIndex = selectedIndex;
	var oldOffset = scrollOffset;

	MoveSelection(delta);

	# Repaint only the two changed rows when the list did not scroll.
	if scrollOffset == oldOffset
	{
		RedrawBrowserRow(oldIndex);
		RedrawBrowserRow(selectedIndex);

		skipFullRedraw = true;
	}
}

#@ <NavigateToBookmark(bmIndex)>
#@ Navigates to the bookmark at ''bmIndex'' if valid.

func NavigateToBookmark(bmIndex)
{
	if bmIndex >= 1 and bmIndex <= len(bookmarks)
	{
		var bm = bookmarks[bmIndex];
		var path = bm["path"];

		if IsDir(path)
		{
			selectedBookmark = bmIndex;
			NavigateTo(path);

			return true;
		}
	}

	return false;
}

#@ <NavigateBack()>
#@ Navigates to the previous directory in history.

func NavigateBack()
{
	while len(dirHistory) > 0
	{
		var prevPath = dirHistory[len(dirHistory)];
		dirHistory = dirHistory - len(dirHistory);

		if IsDir(prevPath)
		{
			navigatingBack = true;
			NavigateTo(prevPath);
			navigatingBack = false;

			return;
		}
	}
}
