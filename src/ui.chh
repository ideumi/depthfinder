#!/usr/bin/chippy
#
# depthfinder - ui.chh
#

#@ <SetFileTypeColor(isSymlink, isDir, isExecutable)>
#@ Sets text color based on file type.

func SetFileTypeColor(isSymlink, isDir, isExecutable)
{
	if isSymlink
	{
		SetAttribute(COLORBOLD);
		SetAttribute(COLORYELLOW);
	}
	elseif isDir
	{
		SetAttribute(COLORBOLD);
		SetAttribute(COLORCYAN);
	}
	elseif isExecutable
	{
		SetAttribute(COLORBOLD);
		SetAttribute(COLORMAGENTA);
	}
}

#@ <FormatCompactDate(timestamp)>
#@ Formats a unix ''timestamp'' as a compact date string.

func FormatCompactDate(timestamp)
{
	if timestamp == 0 { return ""; }

	var now = time();
	var sixMonthsAgo = now - SIXMONTHSSECONDS;

	var parts = GregorianParseTime(timestamp);

	if iserr(parts) { return ""; }

	var months = SHORTMONTHNAMES;

	var year = parts[1];
	var month = parts[2];
	var day = parts[3];
	var hour = parts[4];
	var minute = parts[5];

	var monthStr = months[month];
	var dayStr = str(day);
	var hourStr = str(hour);
	var minStr = str(minute);

	if day < 10 { dayStr = " " + dayStr; }
	if hour < 10 { hourStr = "0" + hourStr; }
	if minute < 10 { minStr = "0" + minStr; }

	if timestamp >= sixMonthsAgo
	{
		return monthStr + " " + dayStr + " " + hourStr + ":" + minStr;
	}
	else
	{
		return monthStr + " " + dayStr + " " + str(year);
	}
}

#@ <DrawSidebar(x, y, width, height, bookmarks, selected, offset, currentPath, hasFocus, isMoving)>
#@ Draws the sidebar with bookmarks list at position ''x'' and ''y'' starting at
#@ ''offset''.

func DrawSidebar(x, y, width, height, bookmarks, selected, offset, currentPath, hasFocus, isMoving)
{
	# One row is reserved at the top of the panel (aesthetics). The rest holds
	# the bookmark list
	var contentY = y + SIDEBARHEADERROWS;
	var contentHeight = height - SIDEBARHEADERROWS;

	for row = 1 to contentHeight
	{
		var idx = offset + row - 1;

		if idx <= len(bookmarks)
		{
			var bm = bookmarks[idx];
			var name = bm["name"];

			var isSelected = idx == selected and hasFocus;
			var isActive = bm["path"] == currentPath;

			var indicator = "  ";

			if isSelected
			{
				if isMoving { indicator = "* "; }
				else { indicator = "> "; }
			}

			var nameText = indicator + str(name);

			# Name field: everything after the number column and its gap. It stops
			# short of the padding and separator columns on the right edge of the
			# panel
			var nameWidth = width - 4;

			nameText = BFClipText(nameText, nameWidth);
			nameText = BFPadText(nameText, nameWidth, BFALIGNLEFT);

			# Numbered jump targets for the 1-9 keys
			if idx <= SIDEBARJUMPMAX
			{
				# Draw the sidebar numbers 1-9
				SetAttribute(COLORBOLD);
				BFDrawText(x, contentY + row - 1, str(idx));
				SetAttribute(COLORRESET);
			}
			else
			{
				BFDrawText(x, contentY + row - 1, " ");
			}

			# Selected (hover)
			if isSelected
			{
				SetAttribute(COLORBGWHITE);
				SetAttribute(COLORBOLD);
				SetAttribute(COLORBLACK);
			}
			elseif isActive # active (currently at directory that is also the bm)
			{
				SetAttribute(COLORWHITE);
				SetAttribute(COLORBOLD);
				SetBGColorRGB(DFNCOLORACCENT["r"], DFNCOLORACCENT["g"], DFNCOLORACCENT["b"]);
			}

			BFDrawText(x + 2, contentY + row - 1, nameText);

			if isSelected or isActive { SetAttribute(COLORRESET); }
		}
		else
		{
			# Clean up any leftover text below the current sidebar text set width
			# - 1: the separator column is drawn by DrawScreen
			BFClearRegion(x, contentY + row - 1, width - 1, 1);
		}
	}
}

#@ <FormatSortIndicator(mode, direction)>
#@ Returns a string indicating current sort ''mode'' and ''direction''.

func FormatSortIndicator(mode, direction)
{
	var arrow = "↑";
	if direction == SORTDESC { arrow = "↓"; }

	if mode == SORTNAME { return "[Name" + arrow + "]"; }
	if mode == SORTSIZE { return "[Size" + arrow + "]"; }
	if mode == SORTMTIME { return "[Date" + arrow + "]"; }

	return "[Name" + arrow + "]";
}

#@ <BrowserColumnWidths(width)>
#@ Returns the browser column widths ''[nameColWidth, dateColWidth, sizeColWidth]''
#@ for a content area of ''width'' columns.

func BrowserColumnWidths(width)
{
	var sizeColWidth = 10;
	var dateColWidth = 13;

	# The name column gets whatever width is left after the filesize and date
	# columns took theirs
	var nameColWidth = width - sizeColWidth - dateColWidth;

	return [nameColWidth, dateColWidth, sizeColWidth];
}

#@ <GetBrowserRegion(screenWidth, screenHeight)>
#@ Returns the browser region as a region map.

func GetBrowserRegion(screenWidth, screenHeight)
{
	# The sidebar takes columns 1 to SIDEBARWIDTH, and the separator line is on
	# column SIDEBARWIDTH. The browser starts two columns to the right of it,
	# with one blank column in between.
	var x = SIDEBARWIDTH + 2;
	var y = 1;
	var width = screenWidth - SIDEBARWIDTH - 2;

	# Keybinds bar state is taken into account in BottomReserve()
	var height = screenHeight - BottomReserve();

	return BFMakeRegion(x, y, width, height);
}

#@ <GetBrowserListRegion(screenWidth, screenHeight)>
#@ Returns the region of the actual file list below the browser header bar as
#@ a region map.

func GetBrowserListRegion(screenWidth, screenHeight)
{
	var region = GetBrowserRegion(screenWidth, screenHeight);

	# The list starts below the BROWSERHEADERROWS header rows
	var listY = region["y"] + BROWSERHEADERROWS;

	return BFMakeRegion(region["x"], listY, region["width"], region["height"] - BROWSERHEADERROWS);
}

#@ <GetSidebarRegion(screenHeight)>
#@ Returns the region of the bookmarks sidebar as a region map.

func GetSidebarRegion(screenHeight)
{
	var x = 1;
	var y = 1;
	var width = SIDEBARWIDTH;
	var height = screenHeight - BottomReserve();

	return BFMakeRegion(x, y, width, height);
}

#@ <DrawBrowserRow(x, baseY, contentWidth, nameColWidth, dateColWidth, sizeColWidth, files, idx, isSelected)>
#@ Draws a single file browser row at position ''baseY''.

func DrawBrowserRow(x, baseY, contentWidth, nameColWidth, dateColWidth, sizeColWidth, files, idx, isSelected)
{
	var isMarked = false;

	if idx <= len(files) { isMarked = files[idx]["marked"]; }

	var emptyRow = BFPadText("", contentWidth, BFALIGNLEFT);

	if isSelected
	{
		SetAttribute(COLORBLACK);
		SetAttribute(COLORBOLD);
		SetAttribute(COLORBGWHITE);
	}
	elseif isMarked
	{
		SetAttribute(COLORWHITE);
		SetAttribute(COLORBOLD);
		SetBGColorRGB(DFNCOLORACCENT["r"], DFNCOLORACCENT["g"], DFNCOLORACCENT["b"]);
	}

	if idx <= len(files)
	{
		var entry = files[idx];
		var name = entry["name"];
		var rawName = name;
		var size = entry["size"];
		var isDir = entry["isDir"];
		var isSymlink = entry["isSymlink"];
		var isExecutable = entry["isExecutable"];
		var mtime = entry["mtime"];

		if not isSelected and not isMarked and rawName != ".."
		{
			SetFileTypeColor(isSymlink, isDir, isExecutable);
		}

		# Format name with prefix
		var prefix = BROWSERNAMEPREFIX;

		if isMarked { prefix = BROWSERMARKEDPREFIX; }

		if isDir
		{
			if isSymlink { name = "~" + str(name) + "/"; }
			else { name = str(name) + "/"; }
		}
		elseif isSymlink
		{
			name = "~" + str(name);
		}

		# The name column holds the prefix plus the name once rendered, so the
		# name is clipped to nameColWidth - len(prefix) to account for it
		var nameText = BFClipText(str(name), nameColWidth - len(prefix));

		# Format date
		var dateStr = "";

		if rawName != ".." { dateStr = FormatCompactDate(mtime); }

		dateStr = BFPadText(dateStr, dateColWidth, BFALIGNRIGHT);

		# Format size
		var sizeStr = "";

		if isDir { sizeStr = "<DIR>"; }
		else { sizeStr = SizeToString(size); }

		sizeStr = BFPadText(sizeStr, sizeColWidth, BFALIGNRIGHT);

		var rowText = BFPadText(prefix + nameText, nameColWidth, BFALIGNLEFT) + dateStr + sizeStr;

		# Underline the name for special entries (executables, dirs and symlinks)
		if not isSelected and not isMarked and rawName != ".." and (isSymlink or isDir or isExecutable)
		{
			BFDrawText(x, baseY, prefix);
			SetAttribute(COLORUNDERLINE);
			BFDrawText(x + len(prefix), baseY, nameText);
			SetAttribute(COLORUNDERLINEOFF);
			BFDrawText(x + len(prefix) + lenv(nameText), baseY, BFPadText("", nameColWidth - len(prefix) - lenv(nameText), BFALIGNLEFT) + dateStr + sizeStr);
		}
		else
		{
			BFDrawText(x, baseY, rowText);
		}

		# Spacing
		BFDrawText(x, baseY + 1, emptyRow);
	}
	else
	{
		BFDrawText(x, baseY, emptyRow);
		BFDrawText(x, baseY + 1, emptyRow);
	}

	SetAttribute(COLORRESET);
}

#@ <DrawBrowserHeaderBar(x, y, width, path, hasFocus, markedCount, clipboardMode, showHidden, sortMode, sortDirection)>
#@ Draws the path title and status bar above the actual file list.

func DrawBrowserHeaderBar(x, y, width, path, hasFocus, markedCount, clipboardMode, showHidden, sortMode, sortDirection)
{
	var segments = [];

	append(segments, m[
			"text": FormatSortIndicator(sortMode, sortDirection),
			"highlighted": sortMode != SORTNAME or sortDirection != SORTASC
		]);

	if showHidden
	{
		append(segments, m["text": "[HIDDEN]", "highlighted": true]);
	}

	if markedCount > 0
	{
		append(segments, m["text": "[" + str(markedCount) + " marked]", "highlighted": true]);
	}

	if clipboardMode == CLIPBOARDCOPY
	{
		append(segments, m["text": "[COPY]", "highlighted": true]);
	}
	elseif clipboardMode == CLIPBOARDCUT
	{
		append(segments, m["text": "[CUT]", "highlighted": true]);
	}

	var statusWidth = 0;

	for segmentIndex = 1 to len(segments)
	{
		statusWidth = statusWidth + lenv(segments[segmentIndex]["text"]) + 1;
	}

	# The header is the path /status bar and one blank padding line below it
	BFClearRegion(x, y, width, BROWSERHEADERROWS);

	# The extra column keeps a gap between the path and the status segments
	var titleWidth = width - statusWidth - 1;

	var title = BFTruncateMiddle(path, titleWidth);

	if hasFocus { SetAttribute(COLORBOLD); }

	BFDrawText(x, y, title);

	if hasFocus { SetAttribute(COLORRESET); }

	# Draw status on the top right
	var statusX = x + width - statusWidth;

	for segmentIndex = 1 to len(segments)
	{
		var segment = segments[segmentIndex];
		var segmentText = segment["text"];

		if segment["highlighted"]
		{
			SetAttribute(COLORWHITE);
			SetAttribute(COLORBOLD);
			SetBGColorRGB(DFNCOLORACCENT["r"], DFNCOLORACCENT["g"], DFNCOLORACCENT["b"]);
		}

		BFDrawText(statusX, y, segmentText);
		SetAttribute(COLORRESET);

		# One-column gap after each segment (counted into statusWidth)
		statusX = statusX + lenv(segmentText) + 1;
	}
}

#@ <DrawBrowserList(x, y, width, height, files, selected, offset, hasFocus)>
#@ Draws the file list at row ''y''. ''offset'' is the index of the first visible
#@ entry.

func DrawBrowserList(x, y, width, height, files, selected, offset, hasFocus)
{
	var cols = BrowserColumnWidths(width);
	var nameColWidth = cols[1];
	var dateColWidth = cols[2];
	var sizeColWidth = cols[3];

	# Calculate how many files can fit
	var visibleFiles = int(height / FILEROWHEIGHT);

	for fileRow = 1 to visibleFiles
	{
		var idx = offset + fileRow - 1;
		var baseY = y + (fileRow - 1) * FILEROWHEIGHT;

		var isSelected = idx == selected and hasFocus;

		DrawBrowserRow(x, baseY, width, nameColWidth, dateColWidth, sizeColWidth, files, idx, isSelected);
	}

	var painted = visibleFiles * FILEROWHEIGHT;

	if painted < height
	{
		BFClearRegion(x, y + painted, width, height - painted);
	}
}

#@ <RedrawBrowserRow(idx)>
#@ Redraws the browser row for file ''idx'' in place if it is within the file
#@ list.

func RedrawBrowserRow(idx)
{
	var region = GetBrowserListRegion(screenWidth, screenHeight);

	var listX = region["x"];
	var listWidth = region["width"];

	var visibleFiles = int(region["height"] / FILEROWHEIGHT);

	# Position of the entry within the file list
	var fileRow = idx - scrollOffset + 1;

	if fileRow < 1 or fileRow > visibleFiles { return; }

	var cols = BrowserColumnWidths(listWidth);
	var nameColWidth = cols[1];
	var dateColWidth = cols[2];
	var sizeColWidth = cols[3];

	var baseY = region["y"] + (fileRow - 1) * FILEROWHEIGHT;
	var isSelected = idx == selectedIndex and focusPanel == FOCUSBROWSER;

	DrawBrowserRow(listX, baseY, listWidth, nameColWidth, dateColWidth, sizeColWidth, files, idx, isSelected);
}

#@ <DrawVerticalSeparator(x, y, height)>
#@ Draws a vertical line separator.

func DrawVerticalSeparator(x, y, height)
{
	SetFGColor256(DFNCOLORDIM);
	BFDrawVLine(x, y, height, "│");
	SetAttribute(COLORRESET);
}

#@ <BottomReserve()>
#@ Returns the number of rows reserved at the bottom of the screen. If not
#@ ''KEYBINDSBARHEIGHT'' then ''1'' is returned for the ". binds" hint.

func BottomReserve()
{
	if showKeybinds { return KEYBINDSBARHEIGHT; }

	return 1;
}

#@ <DrawBottomHint(y, sidebarWidth)>
#@ Draws the ". binds" hint.

func DrawBottomHint(y, sidebarWidth)
{
	# width stops before the separator column
	BFClearRegion(1, y, sidebarWidth - 1, 1);

	SetFGColor256(DFNCOLORDIM);
	BFDrawText(2, y, ". binds");
	SetAttribute(COLORRESET);
}

#@ <DrawKeybindsBar(y, width, focusPanel)>
#@ Draws the keybinds help bar at the bottom of the screen.

func DrawKeybindsBar(y, width, focusPanel)
{
	var rows = [];

	if focusPanel == FOCUSSIDEBAR
	{
		append(rows, []);

		append(rows, [
				m["key": "Up/Down", "action": "Navigate"],
				m["key": "Enter", "action": "Go"],
				m["key": "Space", "action": "Move"],
				m["key": "Del", "action": "Remove"],
				m["key": "Tab", "action": "Browser"],
				m["key": "1-9", "action": "Jump"],
				m["key": "Esc", "action": "Quit"]
			]);

		append(rows, []);
	}
	else
	{
		append(rows, [
				m["key": "↑↓←→", "action": "Navigate"],
				m["key": "Alt+←", "action": "Back"],
				m["key": "Enter", "action": "Open"],
				m["key": "Tab", "action": "Sidebar"],
				m["key": "Space", "action": "Mark"],
				m["key": "a", "action": "All"],
				m["key": "s", "action": "Search"],
				m["key": "r", "action": "Refresh"],
				m["key": "Esc", "action": "Quit"]
			]);

		append(rows, [
				m["key": "Ctrl+C", "action": "Copy"],
				m["key": "Ctrl+X", "action": "Cut"],
				m["key": "Ctrl+V", "action": "Paste"],
				m["key": "Del", "action": "Delete"],
				m["key": "F2", "action": "Rename"],
				m["key": "o", "action": "Open"],
				m["key": "n", "action": "New"],
				m["key": "d", "action": "Mkdir"]
			]);

		append(rows, [
				m["key": "F1", "action": "Term"],
				m["key": "#", "action": "Run"],
				m["key": "h", "action": "Hidden"],
				m["key": "i", "action": "Info"],
				m["key": "c", "action": "Compress"],
				m["key": "t", "action": "Sort"],
				m["key": "p", "action": "Path"],
				m["key": "b", "action": "Bookmark"]
			]);
	}

	# y is the screen height, not the bar's position, the bar is KEYBINDSBARHEIGHT
	# rows tall and sits at the bottom of the screen, so its top row is:
	# y - KEYBINDSBARHEIGHT + 1
	BFKeybindsBar(1, y - KEYBINDSBARHEIGHT + 1, width, rows);
}

#@ <DrawScreen(screenWidth, screenHeight, bookmarks, selectedBookmark, bookmarkOffset, files, selectedFile, fileOffset, currentPath, focusPanel, markedCount, clipboardMode, showHidden, movingBookmark, sortMode, sortDirection)>
#@ Draws the complete screen.

func DrawScreen(screenWidth, screenHeight, bookmarks, selectedBookmark, bookmarkOffset, files, selectedFile, fileOffset, currentPath, focusPanel, markedCount, clipboardMode, showHidden, movingBookmark, sortMode, sortDirection)
{
	var sidebar = GetSidebarRegion(screenHeight);
	var panel = GetBrowserRegion(screenWidth, screenHeight);
	var list = GetBrowserListRegion(screenWidth, screenHeight);

	var separatorHeight = screenHeight;

	if showKeybinds { separatorHeight = screenHeight - KEYBINDSBARHEIGHT; }

	DrawSidebar(sidebar["x"],
		sidebar["y"],
		sidebar["width"],
		sidebar["height"],
		bookmarks,
		selectedBookmark,
		bookmarkOffset,
		currentPath,
		focusPanel == FOCUSSIDEBAR,
		movingBookmark);

	DrawVerticalSeparator(SIDEBARWIDTH, 1, separatorHeight);

	DrawBrowserHeaderBar(panel["x"],
		panel["y"],
		panel["width"],
		currentPath,
		focusPanel == FOCUSBROWSER,
		markedCount,
		clipboardMode,
		showHidden,
		sortMode,
		sortDirection);

	DrawBrowserList(list["x"],
		list["y"],
		list["width"],
		list["height"],
		files,
		selectedFile,
		fileOffset,
		focusPanel == FOCUSBROWSER);

	if showKeybinds { DrawKeybindsBar(screenHeight, screenWidth, focusPanel); }
	else { DrawBottomHint(screenHeight, SIDEBARWIDTH); }
}
