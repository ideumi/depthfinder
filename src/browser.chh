#!/usr/bin/chippy
#
# depthfinder - browser.chh
#

#@ <CreateFileEntry(name, size, isDir, isSymlink, isExecutable, marked, mtime)>
#@ Creates a file entry map.

# We have constructors at home

func CreateFileEntry(name, size, isDir, isSymlink, isExecutable, marked, mtime)
{
	return m[
		"name": name,
		"size": size,
		"isDir": isDir,
		"isSymlink": isSymlink,
		"isExecutable": isExecutable,
		"marked": marked,
		"mtime": mtime
	];
}

#@ <LoadDirectory(path, showHidden, sortMode, sortDirection)>
#@ Loads and returns a sorted list of file entries for ''path''. Directories are
#@ listed first. ''..'' is always added except in root.

func LoadDirectory(path, showHidden, sortMode, sortDirection)
{
	var entries = ListDir(path);

	if iserr(entries) { return err; }

	var dirs = [];
	var files = [];

	for i = 1 to len(entries)
	{
		var name = entries[i];

		if not showHidden and StartsWith(name, ".")
		{
			continue;
		}

		var fullPath = JoinPath(path, name);
		var linfo = lstat(fullPath);
		var info = linfo;

		var isSymlink = not iserr(linfo) and StatType(linfo) == TYPESYMLINK;

		if isSymlink
		{
			info = stat(fullPath);
		}

		var size = 0;
		var isDir = false;
		var isExecutable = false;
		var mtime = 0;

		if not iserr(info)
		{
			size = info[STATSIZE];
			isDir = StatType(info) == TYPEDIR;
			mtime = info[STATMTIME];

			var ownerPerm = int(info[STATMODE] / 100) % 10;
			isExecutable = not isDir and ownerPerm % 2 == 1;
		}

		var entry = CreateFileEntry(name, size, isDir, isSymlink, isExecutable, false, mtime);

		if isDir
		{
			dirs = append(dirs, entry);
		}
		else
		{
			files = append(files, entry);
		}
	}

	var sortedDirs = SortFileEntries(dirs, sortMode, sortDirection);
	var sortedFiles = SortFileEntries(files, sortMode, sortDirection);

	var result = [];

	if path != "/"
	{
		var parentEntry = CreateFileEntry("..", 0, true, false, false, false, 0);

		result = append(result, parentEntry);
	}

	for i = 1 to len(sortedDirs)
	{
		result = append(result, sortedDirs[i]);
	}

	for i = 1 to len(sortedFiles)
	{
		result = append(result, sortedFiles[i]);
	}

	return result;
}

#@ <PadIndex(index)>
#@ Pads an index with leading zeros.

func PadIndex(index)
{
	var s = str(index);
	while len(s) < 8 { s = "0" + s; }

	return s;
}

#@ <PadSortKey(value, width)>
#@ Pads a numeric value.

func PadSortKey(value, width)
{
	var s = str(int(value));
	while len(s) < width { s = "0" + s; }

	return s;
}

#@ <SortFileEntries(entries, mode, direction)>
#@ Sorts file entries by ''mode'' and ''direction''.

func SortFileEntries(entries, mode, direction)
{
	if len(entries) <= 1 { return entries; }

	# Create "key|index" strings for sort(list)
	var sortable = [];

	for i = 1 to len(entries)
	{
		var entry = entries[i];
		var key = "";

		if mode == SORTNAME
		{
			key = lower(entry["name"]);
		}
		elseif mode == SORTSIZE
		{
			key = PadSortKey(entry["size"], 20);
		}
		elseif mode == SORTMTIME
		{
			key = PadSortKey(entry["mtime"], 20);
		}
		else
		{
			key = lower(entry["name"]);
		}

		sortable = append(sortable, key + "|" + PadIndex(i));
	}

	sortable = sort(sortable);

	var sorted = [];

	for i = 1 to len(sortable)
	{
		var parts = split(sortable[i], "|");
		var idx = num(parts[len(parts)]);

		sorted = append(sorted, entries[idx]);
	}

	if direction == SORTDESC
	{
		var reversed = [];

		for i = len(sorted) to 1 step -1
		{
			reversed = append(reversed, sorted[i]);
		}

		return reversed;
	}

	return sorted;
}

#@ <ToggleFileMark(files, index)>
#@ Toggles the ''marked'' flag for the file at the given ''index''. Returns the
#@ updated files list.

func ToggleFileMark(files, index)
{
	if index < 1 or index > len(files) { return files; }

	var entry = files[index];

	entry = entry["marked"] = not entry["marked"];

	return files[index] = entry;
}

#@ <GetMarkedFiles(files, currentPath)>
#@ Returns a list of full paths for all marked files.

func GetMarkedFiles(files, currentPath)
{
	var marked = [];

	for i = 1 to len(files)
	{
		var entry = files[i];

		if entry["marked"]
		{
			marked = append(marked, JoinPath(currentPath, entry["name"]));
		}
	}

	return marked;
}

#@ <ClearAllMarks(files)>
#@ Clears all file marks. Returns the updated files list.

func ClearAllMarks(files)
{
	for i = 1 to len(files)
	{
		var entry = files[i];

		entry = entry["marked"] = false;
		files = files[i] = entry;
	}

	return files;
}

#@ <CountMarkedFiles(files)>
#@ Returns the number of marked files.

func CountMarkedFiles(files)
{
	var count = 0;

	for i = 1 to len(files)
	{
		if files[i]["marked"]
		{
			count = count + 1;
		}
	}

	return count;
}

#@ <GetSelectedFiles(files, currentPath, selectedIndex)>
#@ Returns marked files, or current file if none marked.

func GetSelectedFiles(files, currentPath, selectedIndex)
{
	var selected = GetMarkedFiles(files, currentPath);

	if len(selected) == 0 and selectedIndex >= 1 and selectedIndex <= len(files)
	{
		var name = files[selectedIndex]["name"];

		if name != ".."
		{
			selected = append(selected, JoinPath(currentPath, name));
		}
	}

	return selected;
}

#@ <ToggleSelectAll(files)>
#@ Toggles selection on all files except ''..''. Returns updated files list.

func ToggleSelectAll(files)
{
	var allSelected = true;
	var selectableCount = 0;

	for i = 1 to len(files)
	{
		var name = files[i]["name"];

		if name != ".."
		{
			selectableCount = selectableCount + 1;

			if not files[i]["marked"]
			{
				allSelected = false;
			}
		}
	}

	if selectableCount == 0 { allSelected = false; }

	var newState = not allSelected;

	for i = 1 to len(files)
	{
		var name = files[i]["name"];

		if name != ".."
		{
			var entry = files[i];

			entry = entry["marked"] = newState;
			files = files[i] = entry;
		}
	}

	return files;
}
