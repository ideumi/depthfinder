#!/usr/bin/chippy
#
# depthfinder - dialogs.chh
#

#@ <EnterDialog()>
#@ Sets the in-dialog flag and tells the winsize actor to suppress repaints
#@ until the dialog returns.

func EnterDialog()
{
	inDialog = true;

	if not iserr(winsizeHandle) { send(winsizeHandle, CurrentState()); }
}

#@ <ExitDialog()>
#@ Clears the in-dialog flag.

func ExitDialog()
{
	inDialog = false;

	if not iserr(winsizeHandle) { send(winsizeHandle, CurrentState()); }
}

#@ <OpenDialog(screenWidth, screenHeight, width, height, title)>
#@ Enters dialog mode and draws the frame for a ''width'' x ''height'' dialog
#@ centered in the browser region. Returns ''[x, y, contentX, contentWidth]''.

func OpenDialog(screenWidth, screenHeight, width, height, title)
{
	EnterDialog();

	var region = GetBrowserRegion(screenWidth, screenHeight);
	var origin = BFCenterRect(region, width, height);

	var x = origin[1];
	var y = origin[2];

	BFClearRegion(x, y, width, height);
	BFDrawFrame(x, y, width, height, title, BFBOXROUNDED);

	return [x, y, x + 2, width - 4];
}

#@ <CloseDialog()>
#@ Hides the cursor and leaves dialog mode.

func CloseDialog()
{
	HideCursor();
	ExitDialog();
}

#@ <ShowProgress(screenWidth, screenHeight, title, current, total)>
#@ Displays a centered progress dialog.

func ShowProgress(screenWidth, screenHeight, title, current, total)
{
	var dialog = OpenDialog(screenWidth, screenHeight, DIALOGWIDTH, 8, title);

	var y = dialog[2];
	var contentX = dialog[3];
	var contentWidth = dialog[4];
	var barY = y + 3;

	BFDrawProgressBar(contentX, barY, contentWidth, current, total, BFBOXROUNDED);

	var percent = 0;

	if total > 0 { percent = int((current / total) * 100); }

	var percentText = str(percent) +
		"% (" + str(int(current)) + "/" + str(int(total)) + ")";

	percentText = BFPadText(percentText, contentWidth, BFALIGNCENTER);

	BFDrawText(contentX, barY + 1, percentText);
}

#@ <ShowConfirmDialog(screenWidth, screenHeight, message, defaultYes)>
#@ Shows a centered Yes/No confirmation dialog, with Yes preselected when
#@ ''defaultYes'' == ''true''. Returns the choice, or ''err'' when the dialog is
#@ cancelled.

func ShowConfirmDialog(screenWidth, screenHeight, message, defaultYes)
{
	EnterDialog();

	var region = GetBrowserRegion(screenWidth, screenHeight);

	var result = BFShowConfirm(region, DIALOGWIDTH, "Confirm", message, defaultYes);

	CloseDialog();

	return result;
}

#@ <ShowConfirm(screenWidth, screenHeight, message)>
#@ Shows a confirmation dialog with Yes preselected.

func ShowConfirm(screenWidth, screenHeight, message)
{
	return ShowConfirmDialog(screenWidth, screenHeight, message, true);
}

#@ <ShowConfirmDefaultNo(screenWidth, screenHeight, message)>
#@ Shows a confirmation dialog with No preselected.

func ShowConfirmDefaultNo(screenWidth, screenHeight, message)
{
	return ShowConfirmDialog(screenWidth, screenHeight, message, false);
}

#@ <ConfirmExit()>
#@ The exit confirmation dialog.

func ConfirmExit()
{
	var confirmed = ShowConfirm(screenWidth, screenHeight, "Do you really want to exit?");

	return not iserr(confirmed) and confirmed;
}

#@ <ShowError(screenWidth, screenHeight, message)>
#@ Displays an error message dialog.

func ShowError(screenWidth, screenHeight, message)
{
	EnterDialog();

	var region = GetBrowserRegion(screenWidth, screenHeight);

	BFShowMessage(region, DIALOGWIDTH, "Error", message, COLORRED);

	CloseDialog();
}

#@ <ShowConflictDialog(screenWidth, screenHeight, filename)>
#@ Shows the dialog for handling file conflicts.
#@ Returns ''CONFLICTOVERWRITE'', ''CONFLICTOVERWRITEALL'', ''CONFLICTRENAME'',
#@ ''CONFLICTSKIP'', ''CONFLICTSKIPALL'', or ''err'' on cancel.

func ShowConflictDialog(screenWidth, screenHeight, filename)
{
	var dialog = OpenDialog(screenWidth, screenHeight, DIALOGWIDTH, 12, "File Exists");

	var y = dialog[2];
	var contentX = dialog[3];
	var contentWidth = dialog[4];

	var displayName = BFTruncateMiddle(filename, contentWidth - 2);
	BFDrawText(contentX, y + 2, "'" + displayName + "' already exists.");

	BFDrawText(contentX, y + 3, "What do you want to do?");

	var items = ["Overwrite", "Overwrite All", "Rename", "Skip", "Skip All"];

	var selected = BFMenu(contentX, y + 5, items, 1);

	CloseDialog();

	return selected;
}

#@ <ShowCompressMenu(screenWidth, screenHeight)>
#@ Shows the archive format menu. Returns an index in ''COMPRESSFORMATS'', or
#@ ''err'' if the dialog is cancelled.

func ShowCompressMenu(screenWidth, screenHeight)
{
	var dialog = OpenDialog(screenWidth, screenHeight, 50, 8, "Compress");

	var extensions = [];

	for formatIndex = 1 to len(COMPRESSFORMATS)
	{
		append(extensions, COMPRESSFORMATS[formatIndex]["extension"]);
	}

	var format = BFMenu(dialog[3], dialog[2] + 2, extensions, 1);

	CloseDialog();

	return format;
}

#@ <DrawRenamePatternHint(contentX, row)>
#@ Draws the bulk rename placeholder hint at ''row''.

func DrawRenamePatternHint(contentX, row)
{
	SetAttribute(COLORBOLD);
	BFDrawText(contentX, row, "#");
	SetAttribute(COLORRESET);
	BFDrawText(contentX + 1, row, " Number ");
	SetAttribute(COLORBOLD);
	BFDrawText(contentX + 9, row, "*");
	SetAttribute(COLORRESET);
	BFDrawText(contentX + 10, row, " Extension");
}

#@ <ShowInputDialog(screenWidth, screenHeight, title, prompt, defaultValue, patternHint)>
#@ Shows a centered input dialog, with the bulk rename hint when ''patternHint''
#@ == ''true''. Returns the entered text, or ''err'' if the dialog is cancelled.

func ShowInputDialog(screenWidth, screenHeight, title, prompt, defaultValue, patternHint)
{
	var dialog = OpenDialog(screenWidth, screenHeight, DIALOGWIDTH, 8, title);

	var y = dialog[2];
	var contentX = dialog[3];
	var contentWidth = dialog[4];

	if patternHint { DrawRenamePatternHint(contentX, y + 6); }

	var inputWidth = contentWidth - lenv(prompt) - 2;

	var result = BFTextInput(contentX, y + 3, inputWidth, prompt, defaultValue);

	CloseDialog();

	return result;
}

#@ <ShowInput(screenWidth, screenHeight, title, prompt, defaultValue)>
#@ Shows a centered input dialog.

func ShowInput(screenWidth, screenHeight, title, prompt, defaultValue)
{
	return ShowInputDialog(screenWidth, screenHeight, title, prompt, defaultValue, false);
}

#@ <ShowRenameInput(screenWidth, screenHeight, title, prompt, defaultValue)>
#@ Shows the rename input dialog.

func ShowRenameInput(screenWidth, screenHeight, title, prompt, defaultValue)
{
	return ShowInputDialog(screenWidth, screenHeight, title, prompt, defaultValue, true);
}

#@ <ShowFileInfo(screenWidth, screenHeight, paths)>
#@ Shows the file information dialog.

func ShowFileInfo(screenWidth, screenHeight, paths)
{
	var width = DIALOGWIDTH;
	var numFiles = len(paths);

	var isMulti = numFiles > 1;

	var height = 7;

	var dirCount = 0;
	var fileCount = 0;
	var symlinkCount = 0;
	var totalSize = 0;
	var dirActors = [];

	var dialog = OpenDialog(screenWidth, screenHeight, width, height, "File Info");

	var x = dialog[1];
	var y = dialog[2];

	var contentX = dialog[3];
	var contentWidth = dialog[4];
	var row = y + 1;

	if isMulti
	{
		for pathIndex = 1 to numFiles
		{
			var path = paths[pathIndex];
			var linfo = lstat(path);

			if iserr(linfo) { continue; }

			var lstatType = StatType(linfo);

			if lstatType == TYPESYMLINK
			{
				symlinkCount = symlinkCount + 1;
				continue;
			}

			var info = stat(path);

			if iserr(info) { continue; }

			var statType = StatType(info);

			if statType == TYPEDIR
			{
				dirCount = dirCount + 1;
				var dirActor = actor(CalcDirSizeParallel, path);

				append(dirActors, dirActor);
			}
			else
			{
				fileCount = fileCount + 1;
				totalSize = totalSize + info["size"];
			}
		}

		BFDrawText(contentX, row, "(" + str(numFiles) + " files)");

		row = row + 1;

		var typeParts = [];
		if dirCount > 0
		{
			var dirLabel = "dirs";
			if dirCount == 1 { dirLabel = "dir"; }

			append(typeParts, str(dirCount) + " " + dirLabel);
		}
		if fileCount > 0
		{
			var fileLabel = "files";
			if fileCount == 1 { fileLabel = "file"; }

			append(typeParts, str(fileCount) + " " + fileLabel);
		}
		if symlinkCount > 0
		{
			var linkLabel = "symlinks";
			if symlinkCount == 1 { linkLabel = "symlink"; }

			append(typeParts, str(symlinkCount) + " " + linkLabel);
		}

		var typeStr = join(typeParts, ", ");
		if typeStr == "" { typeStr = "empty"; }

		BFDrawText(contentX, row, "Type: " + typeStr);

		row = row + 1;

		var sizeRow = row;
		BFDrawText(contentX, sizeRow, "Size: Calculating, standby...");

		for actorIndex = 1 to len(dirActors)
		{
			totalSize = totalSize + wait(dirActors[actorIndex]);
		}

		BFClearRegion(contentX, sizeRow, contentWidth, 1);
		BFDrawText(contentX, sizeRow, "Size: " + SizeToString(totalSize) + " (" + str(totalSize) + " bytes)");

		row = row + 2;

		BFDrawText(contentX, row, "Press any key...");

		getch();

		HideCursor();
		ExitDialog();

		return;
	}

	var path = paths[1];

	var info = stat(path);
	var linfo = lstat(path);

	var isSymlink = not iserr(linfo) and StatType(linfo) == TYPESYMLINK;
	var isDir = not iserr(linfo) and StatType(linfo) == TYPEDIR;

	var isExecutable = false;

	if not iserr(info) { isExecutable = IsExecutableMode(info["mode"], isDir); }

	height = 11;
	y = dialog[2] - 2;

	BFClearRegion(x, y, width, height);
	BFDrawFrame(x, y, width, height, "File Info", BFBOXROUNDED);

	row = y + 1;

	var name = BFTruncateMiddle(Basename(path), contentWidth - 6);

	BFDrawText(contentX, row, "Name: ");
	SetFileTypeColor(isSymlink, isDir, isExecutable);
	BFDrawText(contentX + 6, row, name);
	SetAttribute(COLORRESET);

	row = row + 1;

	if iserr(info)
	{
		BFDrawText(contentX, row, "Could not read file info");
		BFDrawText(contentX, row + 2, "Press any key...");

		getch();

		HideCursor();
		ExitDialog();

		return;
	}

	var fileType = StatType(info);

	if isSymlink
	{
		var target = readlink(path);

		if not iserr(target)
		{
			target = BFTruncateMiddle(target, contentWidth - 18);
			BFDrawText(contentX, row, "Type: symlink -> " + target);
		}
		else
		{
			BFDrawText(contentX, row, "Type: symlink (" + fileType + ")");
		}
	}
	else
	{
		BFDrawText(contentX, row, "Type: " + fileType);
	}

	row = row + 1;

	var uid = info["userId"];
	var owner = GetUsernameByUID(uid);
	BFDrawText(contentX, row, "Owner: " + owner);
	row = row + 1;

	var mode = info["mode"];
	BFDrawText(contentX, row, "Permissions: " + str(int(mode)) + " (" + FormatPermissions(mode) + ")");
	row = row + 1;

	var mtime = info["modified"];
	BFDrawText(contentX, row, "Modified: " + GregorianFormatTime(mtime));
	row = row + 1;

	var size = info["size"];
	var sizeRow = row;

	if isDir
	{
		BFDrawText(contentX, sizeRow, "Size: Calculating, standby...");

		var sizeActor = actor(CalcDirSizeParallel, path);
		size = wait(sizeActor);

		BFClearRegion(contentX, sizeRow, contentWidth, 1);
		BFDrawText(contentX, sizeRow, "Size: " + SizeToString(size) + " (" + str(size) + " bytes)");
	}
	else
	{
		BFDrawText(contentX, sizeRow, "Size: " + SizeToString(size) + " (" + str(size) + " bytes)");
	}

	row = row + 3;

	BFDrawText(contentX, row, "Press any key...");

	getch();
	HideCursor();
	ExitDialog();
}

#@ <DrawSortMenuRow(contentX, row, contentWidth, label, highlighted)>
#@ Draws one row in the sort dialog / menu.

func DrawSortMenuRow(contentX, row, contentWidth, label, highlighted)
{
	if highlighted
	{
		SetAttribute(COLORBLACK);
		SetAttribute(COLORBGWHITE);
	}

	BFDrawText(contentX, row, BFPadText(label, contentWidth, BFALIGNLEFT));

	if highlighted { SetAttribute(COLORRESET); }
}

#@ <ShowSortMenu(screenWidth, screenHeight, currentMode, currentDirection)>
#@ Shows the sort options menu.

func ShowSortMenu(screenWidth, screenHeight, currentMode, currentDirection)
{
	var width = 30;
	var height = 11;

	var dialog = OpenDialog(screenWidth, screenHeight, width, height, "Sort");
	var x = dialog[1];
	var y = dialog[2];

	var mode = currentMode;
	var direction = currentDirection;
	var selected = 1;
	var running = true;

	var contentX = dialog[3];
	var contentWidth = dialog[4];

	# Indexes 1-3 pick the mode, 4-5 pick the direction.
	var modes = [SORTNAME, SORTSIZE, SORTMTIME];
	var directions = [SORTASC, SORTDESC];

	var names = ["Name", "Size", "Modified", "Ascending", "Descending"];

	while running
	{
		BFClearRegion(x, y, width, height);
		BFDrawFrame(x, y, width, height, "Sort", BFBOXROUNDED);

		# Mode and direction options
		for item = 1 to len(names)
		{
			var active = false;

			if item <= len(modes) { active = mode == modes[item]; }
			else { active = direction == directions[item - len(modes)]; }

			# Padding for the separator between modes and directions
			var row = y + 1 + item;

			if item > len(modes) { row = row + 1; }

			var label = "  " + names[item];

			if active { label = "> " + names[item]; }

			DrawSortMenuRow(contentX, row, contentWidth, label, selected == item);
		}

		# Separator
		BFDrawHLine(x + 1, y + 1 + len(modes) + 1, width - 2, "─");

		# Render help text
		var helpRow = y + len(names) + 4;

		SetAttribute(COLORBOLD);
		BFDrawText(contentX, helpRow, "Space");
		SetAttribute(COLORRESET);
		BFDrawText(contentX + 5, helpRow, " Select ");
		SetAttribute(COLORBOLD);
		BFDrawText(contentX + 13, helpRow, "Enter");
		SetAttribute(COLORRESET);
		BFDrawText(contentX + 18, helpRow, " Confirm");

		# ---

		var key = getch();

		if key == BFKEYESC
		{
			CloseDialog();

			return err;
		}
		elseif key == KEYSPACE
		{
			if selected <= len(modes) { mode = modes[selected]; }
			else { direction = directions[selected - len(modes)]; }
		}
		elseif key == BFKEYUP
		{
			if selected > 1 { selected = selected - 1; }
		}
		elseif key == BFKEYDOWN
		{
			if selected < len(names) { selected = selected + 1; }
		}
		elseif key == BFKEYENTER
		{
			# Apply and close
			running = false;
		}
	}

	CloseDialog();

	return [mode, direction];
}

#@ <ShowAbout(screenWidth, screenHeight)>
#@ Shows the about dialog.

func ShowAbout(screenWidth, screenHeight)
{
	var dialog = OpenDialog(screenWidth, screenHeight, DIALOGWIDTH, 13, "About");

	var y = dialog[2];
	var contentX = dialog[3];
	var contentWidth = dialog[4];

	var title = PROGRAMNAME + " V-" + VERSION;
	title = BFPadText(title, contentWidth, BFALIGNCENTER);

	var desc = "A simple TUI file manager";
	desc = BFPadText(desc, contentWidth, BFALIGNCENTER);

	var quote = "Into an ocean of stat(path)s";
	quote = BFPadText(quote, contentWidth, BFALIGNCENTER);

	var copyright = "Copyright (c) 2026 ideumi";
	copyright = BFPadText(copyright, contentWidth, BFALIGNCENTER);

	var bfver = "using boxflinger V-" + BFVERSION;
	bfver = BFPadText(bfver, contentWidth, BFALIGNCENTER);

	SetAttribute(COLORBOLD);
	BFDrawText(contentX, y + 2, title);
	SetAttribute(COLORRESET);
	BFDrawText(contentX, y + 3, bfver);
	BFDrawText(contentX, y + 5, desc);
	BFDrawText(contentX, y + 7, quote);
	BFDrawText(contentX, y + 9, copyright);
	BFDrawText(contentX, y + 11, "Press any key...");

	getch();

	CloseDialog();
}
