#!/usr/bin/chippy
#
# depthfinder - timezone.chh
#

load("libstrings.chh");

func CheckIfNumber(number) {
	var numBin = pack(number)[1];

	return numBin >= 48 and numBin <= 57;
}

func TimezoneToSeconds(offset, mode) {
	var setMode = "";

	if mode == "-" {
		setMode = "-";
	}

	if type(offset) == "string" {
		if len(offset) == 4 {
			var nums = [charat(offset, 1),
				charat(offset, 2),
				charat(offset, 3),
				charat(offset, 4)];

			for x = 1 to len(nums) {
				if CheckIfNumber(nums[x]) == false {
					return 0;
				}
			}

			var hours = int(num(join([nums[1], nums[2]], "")));

			var minutes = int(num(join([nums[3], nums[4]], "")));

			return int(num(setMode + str((hours * 3600) + (minutes * 60))));
		}
	}

	return 0;
}

func CalculateTimezone() {
	var dateHandle = popen("date +%z", "r");

	if iserr(dateHandle) {
		return 0;
	}

	var offset = unpack(fread(dateHandle, 0));

	offset = Trim(str(offset));

	pclose(dateHandle);

	if iserr(offset) {
		return 0;
	}

	# ---

	var firstChar = err;

	if len(offset) > 0 {
		firstChar = charat(offset, 1);
	}

	if not iserr(firstChar) {
		if CheckIfNumber(firstChar) == true {
			return TimezoneToSeconds(offset, "");
		} else {
			var offsetNum = slice(offset, 2, len(offset));

			if CheckIfNumber(charat(offsetNum, 1)) == true {
				return TimezoneToSeconds(offsetNum, firstChar);
			}
		}
	}

	return 0;
}
